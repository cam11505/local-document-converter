# Optional path to a local YAML file. Do not commit .env.
LDC_CONFIG_FILE=config/settings.yaml

# Runtime overrides. Environment variables use the LDC_ prefix.
LDC_OUTPUT_DIRECTORY=output
LDC_OVERWRITE=false
LDC_VERBOSE=false
LDC_MAX_FILE_SIZE_MB=100
LDC_MAX_PAGES=500

# OCR is P1 optional and remains disabled by default.
LDC_OCR__ENABLED=false
LDC_OCR__LANGUAGES=["ch","en"]
LDC_OCR__MIN_TEXT_CHARACTERS=40
LDC_OCR__MODEL_CACHE_DIRECTORY=.model-cache
